{
  "name": "metralhas-secretos",
  "productName": "Metralhas Secretos",
  "version": "1.0.0",
  "description": "Jogo de deducao por associacao de palavras, no estilo Codenames, para jogar com amigos pela internet.",
  "author": "Metralhas Secretos",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "server": "node server/index.js",
    "test": "node --test shared/regras.test.js server/integracao.test.js electron/identidade-launcher.test.cjs",
    "icone": "electron scripts/gerar-icone.cjs",
    "build": "npm run icone && electron-builder --win",
    "fontes": "node scripts/baixar-fontes.js"
  },
  "build": {
    "appId": "com.metralhassecretos.app",
    "productName": "Metralhas Secretos",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "shared/**/*",
      "!shared/*.test.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icone.ico"
    },
    "portable": {
      "artifactName": "Metralhas Secretos ${version} (portatil).exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Metralhas Secretos",
      "artifactName": "Metralhas Secretos ${version} (instalador).exe"
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
