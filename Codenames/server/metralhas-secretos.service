# Modelo de servico systemd para o servidor de salas.
#
# Uso, num servidor Linux com Node 20 ou superior:
#   sudo cp metralhas-secretos.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now metralhas-secretos
#
# Ajuste User, WorkingDirectory e PORT conforme a sua maquina.

[Unit]
Description=Servidor de salas do jogo Metralhas Secretos
After=network.target

[Service]
Type=simple
User=metralhas
WorkingDirectory=/opt/metralhas-secretos
Environment=NODE_ENV=production
Environment=PORT=8787
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

# O servidor so precisa ler os proprios arquivos e abrir uma porta.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
